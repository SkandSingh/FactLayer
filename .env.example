# Copy to .env and fill in before running the app. Never commit the real .env.
#
# Fill in GEMINI_API_KEYS / GROK_API_KEYS below -- comma-separated, no spaces,
# one or many keys each. Calls round-robin across every key from every
# provider listed, so each additional key adds its own rate-limit quota to
# the pool. Leave GROK_API_KEYS empty to run on Gemini alone.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash
GROK_API_KEYS=
GROK_MODEL=grok-4-fast

# GEMINI_API_KEY (singular) is a legacy one-key shorthand, kept only for
# backwards compatibility with setups from before multi-key support existed.
# New setups should use GEMINI_API_KEYS above instead -- leave this blank.
GEMINI_API_KEY=
MAX_CONCURRENT_LLM_CALLS=4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
FACTLAYER_DB_PATH=factlayer.db
UPLOAD_MAX_BYTES=52428800
