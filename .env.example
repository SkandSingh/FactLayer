# Copy to .env and fill in before running the app. Never commit the real .env.
#
# Multiple keys per provider are supported (comma-separated, no spaces) --
# calls round-robin across every key from every provider listed below, so
# each additional key adds that key's own rate-limit quota to the pool.
# GEMINI_API_KEY (singular) still works as a one-key shorthand.
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.5-flash
GROK_API_KEYS=
GROK_MODEL=grok-4-fast
MAX_CONCURRENT_LLM_CALLS=4
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
FACTLAYER_DB_PATH=factlayer.db
UPLOAD_MAX_BYTES=52428800
